# Copy this file to .env for local use. On Render, add these as Environment Variables instead.
# NEVER commit your real .env to GitHub.

# FREE AI (recommended to start): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional backup, any OpenAI-compatible service with a free tier, e.g. Groq:
#   OPENAI_COMPAT_URL=https://api.groq.com/openai/v1/chat/completions
OPENAI_COMPAT_URL=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=

# Paid option: Claude. Without this key the site uses its built-in maths engine only.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: which Claude model answers questions (default: claude-haiku-5-5)
ANTHROPIC_MODEL=

# Shown in the footer and on the privacy page (optional)
CONTACT_EMAIL=

# Where the database file is kept. On Render use the disk mount path, e.g. /var/data
DATA_DIR=
PORT=3000
